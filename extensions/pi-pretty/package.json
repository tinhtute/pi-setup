{
	"name": "pi-pretty-vendored",
	"version": "0.8.0",
	"description": "Vendored fork of @heyhuynhgiabuu/pi-pretty for pi-setup (upstream v0.8.0, MIT)",
	"keywords": [
		"pi",
		"pi-extension",
		"pi-package",
		"pretty-print",
		"shiki",
		"syntax-highlighting",
		"terminal"
	],
	"homepage": "https://github.com/heyhuynhgiabuu/pi-pretty#readme",
	"bugs": {
		"url": "https://github.com/heyhuynhgiabuu/pi-pretty/issues"
	},
	"license": "MIT",
	"author": "huynhgiabuu",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/heyhuynhgiabuu/pi-pretty.git"
	},
	"files": [
		"dist/",
		"CHANGELOG.md",
		"src/"
	],
	"main": "dist/index.js",
	"scripts": {
		"build": "tsc",
		"typecheck": "tsc --noEmit",
		"test": "tsc && vitest run",
		"test:watch": "vitest",
		"lint": "biome check src/",
		"lint:fix": "biome check --fix src/"
	},
	"dependencies": {
		"@shikijs/cli": "^4.0.2",
		"shiki": "4.0.2"
	},
	"devDependencies": {
		"@biomejs/biome": "^2.3.5",
		"@earendil-works/pi-ai": "1.3.0",
		"@earendil-works/pi-coding-agent": "1.3.0",
		"@earendil-works/pi-tui": "1.3.0",
		"@types/node": "^20.0.0",
		"typescript": "^7.0.2",
		"vitest": "^4.0.18"
	},
	"peerDependencies": {
		"@earendil-works/pi-ai": "*",
		"@earendil-works/pi-coding-agent": "*",
		"@earendil-works/pi-tui": "*"
	},
	"pi": {
		"extensions": [
			"./src/index.ts"
		]
	},
	"type": "module",
	"private": true
}
